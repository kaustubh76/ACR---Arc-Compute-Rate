{
  "name": "acr-mcp",
  "version": "0.2.0",
  "type": "module",
  "description": "ACR Machine TCA over MCP — check whether your agent can pay, benchmark a machine purchase, grade a seller, verify a print.",
  "license": "MIT",
  "homepage": "https://github.com/kaushtubh02/ACR#readme",
  "repository": { "type": "git", "url": "git+https://github.com/kaushtubh02/ACR.git", "directory": "mcp" },
  "keywords": ["mcp", "model-context-protocol", "x402", "usdc", "arc", "circle", "agent-payments"],
  "bin": { "acr-mcp": "dist/server.js" },
  "main": "dist/tools.js",
  "files": ["dist", "README.md"],
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/server.ts",
