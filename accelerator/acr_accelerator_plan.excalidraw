   "strokeColor": "#e03131",
   "fontSize": 15,
   "fontFamily": 1,
   "text": "THE HONEST BOTTLENECK \u00b7 pre-declared",
   "originalText": "THE HONEST BOTTLENECK \u00b7 pre-declared",
   "textAlign": "left",
   "verticalAlign": "top",
