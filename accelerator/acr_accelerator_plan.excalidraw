   "strokeColor": "#f08c00",
   "fontSize": 15,
   "fontFamily": 1,
   "text": "DEMO DAY, DEFINED \u00b7 nothing claimed a judge cannot click",
   "originalText": "DEMO DAY, DEFINED \u00b7 nothing claimed a judge cannot click",
   "textAlign": "left",
   "verticalAlign": "top",
