  },
  {
   "angle": 0,
   "backgroundColor": "transparent",
   "boundElements": null,
   "fillStyle": "solid",
   "frameId": null,
   "groupIds": [],
   "isDeleted": false,
   "link": null,
   "locked": false,
   "opacity": 100,
