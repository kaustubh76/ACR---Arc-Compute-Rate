{
  "name": "acr-float",
  "version": "0.1.0",
  "private": true,
  "description": "Float — an agent treasury that forecasts, earns, and refuses. Keeper, server, MCP tools and the demo agents.",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prices": "node --import tsx src/bin/prices.ts",
    "local": "node --import tsx src/bin/local.ts",
    "keeper": "node --import tsx src/bin/keeper.ts",
    "server": "node --import tsx src/bin/server.ts",
    "agents": "node --import tsx src/bin/agents.ts",
    "verify": "node --import tsx src/bin/verify.ts"
  },
  "dependencies": {
    "viem": "2.55.8",
    "hono": "4.6.14",
    "@hono/node-server": "1.13.7",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "@types/node": "22.10.2"
  }
}
