  {
   "id": "t-0226",
   "type": "text",
   "x": 2873,
   "y": 624.5,
   "width": 596,
   "height": 146.2,
   "strokeColor": "#1e1e1e",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "text": "methodology paper published (OSS)\nN hourly prints live on-chain\nattack-cost-per-bp on EVERY print\nX wash attacks absorbed (red-team)\nnaive-VWAP err  vs  ACR err  (chart)\nlive future quotes + Y settled trades\n5+ sellers attested on-chain\n100% Foundry invariants passing\n181 python + 50 forge tests green",
   "originalText": "methodology paper published (OSS)\nN hourly prints live on-chain\nattack-cost-per-bp on EVERY print\nX wash attacks absorbed (red-team)\nnaive-VWAP err  vs  ACR err  (chart)\nlive future quotes + Y settled trades\n5+ sellers attested on-chain\n100% Foundry invariants passing\n181 python + 50 forge tests green",
   "autoResize": false,
