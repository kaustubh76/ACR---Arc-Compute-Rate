  {
   "id": "t-0103",
   "type": "text",
   "x": 1593,
   "y": 794.5,
   "width": 596,
   "height": 60.0,
   "strokeColor": "#1e1e1e",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "text": "opens an RPC and reads the vault, the store and the sleeve directly\nrunway in TOKENS, not dollars: the denominator is the invention\nthe tape: every payment and every refusal, each linking to the chain\ncannot lie about freshness — if the keeper stops, the print ages on screen",
   "originalText": "opens an RPC and reads the vault, the store and the sleeve directly\nrunway in TOKENS, not dollars: the denominator is the invention\nthe tape: every payment and every refusal, each linking to the chain\ncannot lie about freshness — if the keeper stops, the print ages on screen",
   "autoResize": false,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
