  {
   "id": "t-0096",
   "type": "text",
   "x": 53,
   "y": 1060,
   "width": 656,
   "height": 18.8,
   "strokeColor": "#e03131",
   "fontSize": 15,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "text": "Arc Studio's three roles",
   "originalText": "Arc Studio's three roles",
   "autoResize": false,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "boundElements": null,
   "link": null,
   "locked": false,
   "isDeleted": false,
   "fillStyle": "solid",
   "backgroundColor": "transparent",
   "seed": 100679,
   "version": 1,
   "versionNonce": 201261,
   "updated": 1731542400000
  },
  {
   "id": "t-0098",
   "type": "text",
   "x": 53,
   "y": 1084.5,
   "width": 656,
   "height": 120.0,
   "strokeColor": "#1e1e1e",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "text": "COMPILES the policy: the treasurer writes a sentence in English, Studio emits\n  JSON, and our own validator REFUSES it if it is wrong — Studio's output is\n  checked, not trusted ('I checked it by eye', it said)\nAUDITS the vault, including the checkpoint path; findings triaged in commits\nDEPLOYS the contracts to Arc Testnet\n\nIt did not write the vault, the tests, the keeper, the agents or the dashboard.\nIt HOSTS the dashboard byte-for-byte. A narrow claim survives a judge.",
   "originalText": "COMPILES the policy: the treasurer writes a sentence in English, Studio emits\n  JSON, and our own validator REFUSES it if it is wrong — Studio's output is\n  checked, not trusted ('I checked it by eye', it said)\nAUDITS the vault, including the checkpoint path; findings triaged in commits\nDEPLOYS the contracts to Arc Testnet\n\nIt did not write the vault, the tests, the keeper, the agents or the dashboard.\nIt HOSTS the dashboard byte-for-byte. A narrow claim survives a judge.",
   "autoResize": false,
   "angle": 0,
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "boundElements": null,
   "link": null,
   "locked": false,
   "isDeleted": false,
   "fillStyle": "solid",
   "backgroundColor": "transparent",
   "seed": 100693,
   "version": 1,
   "versionNonce": 201287,
   "updated": 1731542400000
  },
