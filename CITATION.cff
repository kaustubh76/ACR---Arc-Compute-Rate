    given-names: Kaustubh
repository-code: "https://github.com/kaustubh76/ACR---Arc-Compute-Rate"
url: "https://arc-compute-rate.vercel.app"
license: MIT
date-released: "2026-09-27"
keywords:
  - reference rate
  - price index
  - state-space estimation
  - market manipulation
  - x402
  - Arc
  - USDC
  - agentic payments
