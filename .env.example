# ACR configuration — copy to .env and fill in for LIVE Circle/Arc wiring.
# Leave everything blank for hermetic/offline mode (the default): the simulator
# tape, the dev-mode x402 gate, and raw-key/offline signing all keep working.
# All variables use the ACR_ prefix. Keep values on the SAME line as the `=`
# (no trailing inline comments — dotenv would treat them as part of the value).

# --- Arc network (Circle Arc testnet) ---
ACR_ARC_RPC_URL=https://rpc.testnet.arc.network
ACR_ARC_CHAIN_ID=5042002
# USDC is a native system contract on Arc AND the gas token (no ERC-4337 paymaster needed).
ACR_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# CAIP-2 network id; leave blank to derive eip155:{ACR_ARC_CHAIN_ID}.
ACR_ARC_NETWORK_CAIP2=
# Block-explorer base URL (tx/address links in the Terminal).
ACR_EXPLORER_BASE=https://testnet.arcscan.app

# --- Deployed ACR contracts (from scripts/deploy_circle.py or Foundry) ---
ACR_ORACLE_ADDRESS=
ACR_REGISTRY_ADDRESS=
# Cash-settled futures venue (ACRFutures) — the on-chain instrument desk. Blank
# → the term structure still renders from the maker model, but with no live
# on-chain positions / settlement. Deploy via Foundry (script/Deploy.s.sol).
ACR_FUTURES_ADDRESS=
# Futures initial margin in basis points (deploy-time; default 20%).
ACR_FUTURES_MARGIN_BPS=2000

# --- Signing: EITHER a raw key (dev) OR Circle Wallets (custody) ---
# Raw key path (local/anvil dev). Blank = poster stays offline (logs only).
ACR_POSTER_PRIVATE_KEY=

# Circle Developer-Controlled Wallets path (production). Requires `uv sync --extra circle`.
# ACR_CIRCLE_API_KEY format: PREFIX:ID:SECRET
ACR_CIRCLE_API_KEY=
# ACR_CIRCLE_ENTITY_SECRET: 32-byte hex; register its public-key ciphertext once in the Circle console.
ACR_CIRCLE_ENTITY_SECRET=
# The oracle poster / deployer wallet id, and the wallet-set for creating wallets / deploying.
ACR_CIRCLE_WALLET_ID=
ACR_CIRCLE_WALLET_SET_ID=
ACR_CIRCLE_BASE_URL=https://api.circle.com

# --- x402 / Nanopayments (the machine-pays-per-query gate) ---
# Blank facilitator URL = dev-mode gate (accepts a mock header). Set URL + PAY_TO to go live.
# ACR_X402_MODE overrides selection: auto = Circle iff URL+PAY_TO set; dev = force the
# mock gate even with Circle vars present (Terminal demo loops); circle = force the real
# gate (fails closed if unconfigured).
ACR_X402_MODE=auto
# Circle Gateway facilitator base URL. The Gateway x402 endpoints
# (POST /v1/x402/verify and POST /v1/x402/settle) are appended automatically.
# Prefilled with the Arc-testnet facilitator — still offline-safe: auto mode
# only selects the Circle gate once ACR_X402_PAY_TO is a real 0x address.
# Mainnet: https://gateway-api.circle.com
ACR_X402_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# Our receiving wallet (the seller).
ACR_X402_PAY_TO=
ACR_X402_SCHEME=exact
ACR_X402_MAX_TIMEOUT_SECONDS=60
# Per-query price in USDC (sub-cent — a Nanopayment).
ACR_X402_PRICE_USDC=0.0001
# Circle GatewayWallet contract (extra.verifyingContract buyers sign against).
# Default is the shared TESTNET GatewayWallet; change for mainnet.
ACR_X402_GATEWAY_WALLET=0x0077777d7EBA4688BDeF3E311b846F25870A19B9
# Public URL base for the resource; blank = derive from the request.
ACR_X402_RESOURCE_BASE=

# --- Tape source ---
# "sim" (calibrated simulator), "arc" (live Arc testnet USDC scan), or
# "receipts" (the authoritative x402 settlement ledger — needs ACR_RECEIPT_LOG_PATH).
# --- The Graph ---------------------------------------------------------------
# The deployed acr-tape subgraph. Empty → every subgraph-backed surface (/tca,
# /rating, /graph/query, ACR_TAPE_SOURCE=graph) reports itself UNAVAILABLE
# rather than serving a zero. "+0 bp" and "we could not read the tape" are
# different facts and one must never render as the other.
ACR_SUBGRAPH_URL=
# Subgraph Studio API key. SERVER-SIDE ONLY — this is why /graph/query exists;
# a key shipped to a browser is a key anyone can spend the quota of.
ACR_GRAPH_API_KEY=

# Deployed ACROracleV2 (make deploy-oracle-v2) — prints that carry the cleaning
# policy hash, the estimation window and the human-denominated bound, so a print
# can be re-derived rather than trusted. Set this and the poster dual-posts.
#
# DO NOT REPOINT ACR_ORACLE_ADDRESS at it. ACRFutures.oracle is immutable and
# the venue refuses a print older than two hours, so if v1 stopped printing
# every expired open series would be unsettleable and its collateral stranded.
#
# And run `make backfill-oracle-v2` BEFORE the first live post: postPrint
# enforces strictly monotone timestamps, so an earlier print can never be
# inserted afterwards.
ACR_ORACLE_V2_ADDRESS=

# Deployed ReceiptMirror (make deploy-mirror). Circle Gateway settles x402
# off-chain and returns a batch UUID, not a transaction, so without this there
# is no settlement event on Arc for the subgraph to index at all. Empty → the
# mirror keeper stands down instead of writing nowhere.
ACR_RECEIPT_MIRROR_ADDRESS=

# Deployed HumanIdMirror (make deploy-humanid). Records WINDOW-ROTATED CLUSTER
# IDS — keccak256(nullifier, salt, window) — so the tape can tell which wallets
# act for one verified human without ever publishing a World ID nullifier.
# Empty → the tape has no human resolutions, `human_depth` reports itself
# unavailable rather than scoring a seller zero for it, and the manipulation
# bound stays denominated in wallets.
ACR_HUMANID_MIRROR_ADDRESS=
# keccak256 of the resolver's salt — the COMMITMENT, never the salt itself.
# Required by `make deploy-humanid`, and immutable once deployed: a resolver that
# could change its salt afterwards could retroactively manufacture whichever
# grouping flattered a number. Never put the raw salt in an env var that reaches
# forge — constructor arguments land in contracts/broadcast/, which is committed.
ACR_HUMANID_SALT_COMMITMENT=
# THE SALT ITSELF — the linkability secret. Anyone holding this and a nullifier
# can confirm which wallets are that human's, which is exactly what rotation
# exists to prevent. Server-side only: never log it, never return it, never pass
# it to forge (constructor args land in contracts/broadcast/, which is committed).
# Must hash to ACR_HUMANID_SALT_COMMITMENT above — /humanid/info reports whether
# it does, because a mismatched salt derives cluster ids that match nothing and
# reads exactly like "this human has never traded".
ACR_HUMANID_SALT=
# Verifier selection, mirroring ACR_X402_MODE: auto | dev | agentkit.
# auto → AgentKit only when the URL and app id below both look real.
ACR_HUMANID_MODE=auto
# World AgentKit proof-verification endpoint and the Developer Portal app a
# proof must be scoped to. Empty → the dev verifier (nonce + replay protection
# are still real; what it cannot do is prove a human exists).
ACR_HUMANID_VERIFIER_URL=
ACR_HUMANID_APP_ID=
# Demo identities are World ID Sandbox identities, not Orb-verified people.
# Surfaced on /humanid/info so the limit of "verified human" here is visible
# without taking the README's word for it.
ACR_HUMANID_SANDBOX=true

# AgentBook lives on WORLD CHAIN, not Arc — the first reader here that points at
# a second chain. Both empty → the fixture roster in
# packages/acr_oracle_client/acr_oracle_client/demo_humans.py, which is what the
# demo runs on until Sandbox access exists. Every fixture human is flagged
# sandbox all the way onto the chain, so nothing counts them silently.
ACR_WORLD_RPC_URL=
ACR_AGENTBOOK_ADDRESS=
# How often the keeper sweeps settled receipts onto the mirror (seconds).
# Minutes, not hours: the contract only accepts an ordinary mirror within an
# hour of the settlement.
ACR_KEEPER_MIRROR_S=120

# sim  = the calibrated simulator (default, honest when no priced tape exists)
# arc  = live Arc USDC transfers (no service, no size — cannot price)
# receipts = the facilitator's own x402 ledger (an audit tape)
# graph = the INDEXED settlement tape — the only source carrying a per-seller
#         unit price, and so the only one TCA can be computed from. Needs
#         ACR_SUBGRAPH_URL.
ACR_TAPE_SOURCE=sim

# --- Webhooks + durable ledgers (cloud) ---
# Circle webhook signature verification: pin the P-256 public key (fully offline
# verify) OR leave blank to fetch it by key-id using ACR_CIRCLE_API_KEY. Blank +
# no API key = events still recorded, marked verified=null.
ACR_CIRCLE_WEBHOOK_PUBLIC_KEY=
# JSONL append-logs (survive restarts; on ephemeral cloud FS use a mounted volume
# at /app/data for durability). Receipt log blank = durable settlement ledger off.
ACR_WEBHOOK_LOG_PATH=data/webhook_events.jsonl
ACR_RECEIPT_LOG_PATH=data/x402_receipts.jsonl

# --- Service / cloud ---
# How often the background loop refreshes the store + posts prints. Keep 30 for
# local dev; set 3600 (hourly) in cloud so the poster doesn't post every 30s.
# A free-tier host that sleeps needs a keep-warm ping (see
# .github/workflows/keepalive.yml) — the loop also posts immediately on wake
# when the on-chain record is overdue.
ACR_REFRESH_SECONDS=30
# CORS allowed origins for the public API ("*" = allow all — testnet-demo default;
# set to your Terminal origin to lock down; blank = CORS off).
ACR_CORS_ORIGINS=*
# Sim footprint knobs (small-cloud sizing; defaults preserve the rich local run).
# The attack sim is the heaviest transient allocation — a 512MB box sets ~1250
# (floor ~800: below that the cleaning stack starves and the run errors).
#ACR_SIM_EVENTS_PER_SERVICE=3000
#ACR_ATTACK_SIM_EVENTS_PER_SERVICE=1250
# How many blocks back ArcSource scans for USDC Transfer logs (arc tape only).
#ACR_ARC_TAPE_LOOKBACK_BLOCKS=800

# --- Terminal (apps/terminal) ---
# Server-side proxy target for all of the Terminal's /api/* routes, and the
# build-time-inlined public base for the /developers docs link.
#ACR_API=https://acr-api-1fto.onrender.com
#NEXT_PUBLIC_ACR_API=https://acr-api-1fto.onrender.com
# Enables the Terminal's LIVE Circle buyer ("Settle for real", wallet panel,
# /api/buy) — a funded testnet EOA with an OPEN Gateway deposit. Server-only,
# hard $0.01 per-run cap. See docs/agent-runbook.md §4b.
#ACR_BUYER_PRIVATE_KEY=

# --- Buyer agent (apps/agent) + contract deploys ---
# make agent-live pays the gated endpoints for real (testnet USDC).
#AGENT_PRIVATE_KEY=
# make deploy-testnet uses this to deploy ACROracle + AttestationRegistry.
#DEPLOYER_PRIVATE_KEY=

# --- CLOUD DEPLOY (Render today: deploy/deploy-render.sh · Cloud Run:
# deploy/deploy-cloudrun.sh — see docs/DEPLOY.md) ---
# The container reads $PORT (Render/Cloud Run inject it). MINIMAL public deploy
# needs NO secrets: live oracle reads + x402 Circle settlement + webhook
# recording all work with only the non-secret vars above (ORACLE/REGISTRY
# addresses, RPC, X402_MODE=circle, FACILITATOR_URL, PAY_TO, TAPE_SOURCE). Add
# signing secrets (POSTER key or the CIRCLE_* set) ONLY if you want the cloud
# instance to also post hourly prints (then also set ACR_REFRESH_SECONDS=3600
# and keep the box awake — keepalive workflow above).

# --- OPERATOR CONSOLE (optional; OFF unless the token is set) ---
# The systems ledger at /ops is public and read-only, and needs nothing here.
# Setting a token additionally exposes POST /ops/actions — the money-moving
# Makefile targets (settle, roll, collateral top-up, treasury transfer, pause)
# behind a bearer key. With it UNSET those routes answer 404, not 401: an
# endpoint that admits it exists is one worth guessing at, and most deploys
# want none of this. Every action dry-runs unless the caller explicitly says
# dry_run:false, and every attempt is appended to ACR_OPS_AUDIT_PATH.
#
# Generate with `openssl rand -hex 32` — NOT `-base64`. The Terminal's proxy
# bounds the header charset to [A-Za-z0-9._-], so a base64 token's + / = are
# rejected before they ever reach the press, and the console reports that as
# "that key was not accepted" — indistinguishable from a wrong key.
#ACR_OPS_TOKEN=
# Rejected keys this process will answer before it stops listening, and the
# window. Failures are counted; successes are not — so guessing is bounded
# without letting a stranger's noise lock the operator out mid-incident.
#ACR_OPS_MAX_BAD_KEYS=20
#ACR_OPS_BAD_KEY_WINDOW_S=900
# How often the press recomputes the ledger (seconds; default 900). It is a
# SEPARATE timer from the 60s chain warm on purpose — a full sweep must not
# compete with the reads that keep the press's own caches hot.
#ACR_OPS_VERIFY_S=900
#ACR_OPS_AUDIT_PATH=data/ops_actions.jsonl
# Per-run ceilings, enforced server-side whatever the UI sends. The transfer
# also honours the faucet reserve: a move that would leave the drip unable to
# pay the next readers' stakes is refused, not quietly reduced.
#OPS_MAX_FUND_USDC=5.0

# --- FEED ACCESS ATTESTOR (read-only surfacing) ---
# The fourth contract. Set this and the Terminal's colophon names it alongside
# ACROracle / AttestationRegistry / ACRFutures. Redeeming stays operator-side
# (scripts/attest_feed_access.py); the service only reads the address.
#ACR_ATTESTOR_ADDRESS=

# --- MODEL ARMOR: the screen on agent-to-agent traffic -----------------------
# Screens BOTH directions — the request going out and the reply coming back.
# Screening only one leaves the other as the way in.
#
# auto = gcp iff project + location + template + credentials are ALL set, else
# the offline local floor; local = deterministic, no network; gcp = force it and
# fail closed if unconfigured; off = no screening, stated rather than silent.
ACR_ARMOR_MODE=auto
ACR_ARMOR_PROJECT_ID=
# REGIONAL, and the endpoint repeats the region in the host AND the resource
# path. A wrong value fails as a 404 on the TEMPLATE, which reads exactly like
# "the template does not exist" — a template in asia-south1 was once reported
# absent because four US regions were checked and nineteen exist. No default:
# guessing a region is how that happens.
ACR_ARMOR_LOCATION=
ACR_ARMOR_TEMPLATE=
# A PATH to the service-account JSON, never the JSON itself: this file is the one
# most likely to be pasted into an issue. Put the key under data/, which is
# gitignored and already holds ACR_CIRCLE_ENTITY_SECRET.txt.
#
# It MUST be a service account. Model Armor is IAM-gated and rejects API keys
# outright — a key carries no IAM role for roles/modelarmor.user to attach to.
# `gcloud auth application-default login` works on a laptop and is worthless in
# CI or on a container host, because ADC is a USER credential.
ACR_ARMOR_CREDENTIALS_FILE=
# Latency budget, not generosity: on timeout the screen FAILS CLOSED, because a
# screen that admits traffic it could not inspect is not a screen.
#ACR_ARMOR_TIMEOUT_S=10.0

# --- AGENT CARDS: who is calling ---------------------------------------------
# An agent presents a signed EIP-712 card in the AGENT-CARD header. The gate
# recovers the signature and believes the KEY, not a registry — so nobody has to
# be enrolled and there is no allowlist to run.
#
# The card's domain names NO verifyingContract, which is what permissionless
# means here, and which is why `audience` exists: a bare {name, version, chainId}
# domain is valid at any verifier on the chain, so without an audience a card
# minted for another ACR-domain service would be presentable here. Never set this
# to a wildcard.
ACR_AGENT_AUDIENCE=acr-index-api
#
# The key OUR OWN callers sign cards with — scripts/verify_live.py, and anything
# else of ours that calls the API as an agent. Deliberately NOT the poster key:
# `build_role_signer("reader")` used to fall through to ACR_POSTER_PRIVATE_KEY,
# which signed a read-only credential with the key that posts the oracle. It now
# refuses to, so this is the only way a reader card gets signed. Empty → our
# callers present no card and are served anonymously, which is a working state.
#
# The buyer agent uses AGENT_PRIVATE_KEY instead (its own env, its own identity).
# The Terminal's tape polling presents NO card, because every reader shares that
# one process and one card would mean one rate-limit bucket for all of them; the
# only cards the Terminal ever sends are the ones /developers mints on purpose — a
# visitor's throwaway key signed in their own tab, or the demo human's, minted
# server-side from a public label — and each is one probe, not a shared identity.
ACR_READER_PRIVATE_KEY=
#
# The buyer agent (apps/agent) may CLAIM a human on its card by setting, in ITS env
# (not ACR_-prefixed — the agent reads process.env directly):
#   AGENT_HUMAN_CLUSTER=0x<64 hex>   the cluster HumanIdMirror records for the
#                                    agent's wallet in the CURRENT window
# Opt-in, because the gate verifies claims against the chain and refuses one it
# cannot confirm with a 401 — a wrong value, or a window that rolled under it,
# stops the buying loop rather than quietly demoting the card. Unset = claim nothing.
#
# THREE TIERS, and only the third is scarce:
#   anonymous  no card -> the host ceiling, which behind one proxy is GLOBAL
#   carded     a signed card -> per-KEY, and keys are free to mint
#   human      a card whose cluster HumanIdMirror.clusterOf confirms -> per-PERSON
#
# The human tier needs ACR_HUMANID_MIRROR_ADDRESS set and resolutions recorded in
# the CURRENT rotation window. Cluster ids are keccak(nullifier, salt, window), so
# they change completely every 7 days — a card minted against last week's id is
# refused with an explicit "re-mint", not with "your claim is false".
#
# THE MCP SERVER (mcp/) is a carded caller too, and reads ITS OWN env — see
# mcp/README.md. Set in the MCP host's config, not here:
#   ACR_API                   the seller to call (default https://acr-api-1fto.onrender.com)
#   ACR_AGENT_PRIVATE_KEY     signs the card; unset -> anonymous, a working state
#   ACR_AGENT_HUMAN_CLUSTER   opt-in human claim, same rules as AGENT_HUMAN_CLUSTER
#   ACR_ARC_CHAIN_ID          default 5042002
#   ACR_HUMAN_NULLIFIER       lets `my_tca("me")` answer the human-proof challenge
#
# --- OPERATOR KNOBS read outside ACRSettings ---------------------------------
# The poster wallet signs EVERY print; when it runs dry the whole product stops.
# /ops funding and scripts/verify_live.py FAIL (not warn) below this many USDC.
ACR_PRESS_CRITICAL_USDC=1.0
#
# scripts/demo_agent.py — the ten-act agent demo. Unset -> it boots its own
# read-only API on the first free port from DEMO_AGENT_PORT and runs against that.
#   DEMO_AGENT_API=https://acr-api-1fto.onrender.com   run against a deployed host
#   DEMO_AGENT_PORT=8099        first port tried for the local read-only API
#   DEMO_AGENT_BOOT_S=90        how long to wait for it to answer /health
#   DEMO_AGENT_TIMEOUT_S=25     per-request timeout (a sleeping free tier wakes slowly)
